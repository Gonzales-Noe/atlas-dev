# Backend Environment Variables
# Copy this file to .env and fill in the actual values.
# NEVER commit real secrets — use placeholders here only.

# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres.your-supabase-project-ref
DB_PASSWORD=your-database-password
DB_HOST=aws-0-your-region.pooler.supabase.com
# Transaction pooling avoids holding one of the limited session-mode clients per worker.
DB_PORT=5432
DB_SSLMODE=require

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-app-password

# Google Sheets API Configuration - Browser API Key
GOOGLE_API_KEY=your-google-api-key

# Google Sign-In (OAuth Web client ID used to verify mobile ID tokens)
GOOGLE_OAUTH_CLIENT_IDS=your-google-oauth-client-id.apps.googleusercontent.com

# Ollama Cloud API Configuration (api.ollama.ai — OpenAI-compatible)
# OLLAMA_CLOUD_API_KEY=replace-me
# OLLAMA_CLOUD_BASE_URL=https://api.ollama.ai/v1
# OLLAMA_CLOUD_MODEL=llama3.2

# LLM providers — free online open-weight models, tried in order (LLM_PROVIDER_CHAIN).
# Add as many keys as you can: when one provider is rate-limited or out of
# quota, requests move to the next one. Providers without a key are skipped.
# LLM_PROVIDER_CHAIN=groq,nvidia,mistral,gemma,cloudflare,openrouter,huggingface

# Groq — fastest; 8K tokens/min on the free tier (big prompts skip it). https://console.groq.com/keys
GROQ_API_KEY=gsk_replace_me
# GROQ_MODEL=openai/gpt-oss-120b   (alternatives: openai/gpt-oss-20b, qwen/qwen3.8-27b)

# NVIDIA NIM — 40 req/min, 10,000 req/day, 1M context. https://build.nvidia.com
# NVIDIA_API_KEY=nvapi-replace-me
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Mistral — free "Experiment" plan (phone verification; prompts may be used for training). https://console.mistral.ai/api-keys
# MISTRAL_API_KEY=replace-me
# MISTRAL_MODEL=mistral-small-latest

# Google AI Studio — open-weight Gemma 4 on the free tier. https://aistudio.google.com/apikey
# GEMINI_API_KEY=replace-me
# GEMMA_MODEL=gemma-4-31b-it

# Cloudflare Workers AI — 10,000 neurons/day. https://dash.cloudflare.com/profile/api-tokens
# CLOUDFLARE_ACCOUNT_ID=replace-me
# CLOUDFLARE_API_TOKEN=replace-me
# CLOUDFLARE_MODEL=@cf/openai/gpt-oss-120b

# OpenRouter — :free models, 50 req/day (1,000/day after a one-time $10 top-up). https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-replace-me
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free

# Hugging Face router — uses HF_TOKEN (same token as hosted embeddings); small monthly free credit.
# HF_LLM_MODEL=openai/gpt-oss-120b

# First provider to try. "auto" walks the free online chain; Ollama is last-resort on the VPS.
DEFAULT_LLM_PROVIDER=groq
# Syllabus template refine is OFF by default (parser-first). When refine=true|auto,
# use this provider (ollama on VPS). Pass refine=groq on the API to force cloud.
# SYLLABUS_REFINE_PROVIDER=ollama

# Ollama runs on the Hostinger VPS only (not on your PC). See OLLAMA_SETUP.md.
# Native install: http://127.0.0.1:11434
# docker-compose.vps.yml: http://ollama:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Small model for KVM 2 (8 GB) with Django + local embeddings. Do not use 7B+ on KVM 2.
OLLAMA_DEFAULT_MODEL=llama3.2:3b

# local       – run the model in-process with sentence-transformers (needs PyTorch)
# cloudflare  – same model on Cloudflare Workers AI, 10,000 free neurons/day (no PyTorch; for Render)
#               needs CLOUDFLARE_ACCOUNT_ID + CLOUDFLARE_API_TOKEN (Workers AI permission)
# huggingface – same model via Hugging Face Inference Providers (needs HF credits)
# List several to fall back in order, e.g. EMBEDDING_PROVIDER=cloudflare,huggingface
# All produce identical BGE vectors, so documents indexed with one are searchable with the others.
EMBEDDING_PROVIDER=local
# BGE-base-en-v1.5 (768-dim) — must match GlobalDocumentChunk.embedding_vector dimensions
LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# PII masking before RAG chunking / LLM prompts (emails, PH mobiles, signatures).
# Labeled names only (Instructor:, Prepared by:) — topic names like Newton/Rizal are kept.
# PII_MASK_NAMES=true
# PII_MASK_LANDLINES=false
# Required when EMBEDDING_PROVIDER=huggingface: token with "Inference Providers" permission
# HF_TOKEN=hf_...
# Load the local model at server start instead of on the first upload/search
# PRELOAD_EMBEDDER=true
# ==============================================================================
# Environment & General Django Settings
# ==============================================================================
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=DEBUG

# PayMongo test credentials from your PayMongo dashboard
PAYMONGO_SECRET_KEY=sk_test_replace_me
PAYMONGO_WEBHOOK_SECRET=whsec_replace_me
