# Backend Environment Variables
# Copy this file to .env and fill in actual values.

# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-change-me
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,atlas-rcch.onrender.com

# Database (Supabase Postgres — required; no localhost fallback)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres.<your-project-ref>
DB_PASSWORD=<your-supabase-db-password>
DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
DB_PORT=5432

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# API Keys
GOOGLE_API_KEY=your_google_api_key
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
GROQ_API_KEY=your_groq_api_key

# LLM Routing
# Supported options: gemini, openrouter, groq, gpt, anthropic
DEFAULT_LLM_PROVIDER=gemini

# Local Ollama (local dev only — not used on Render)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=deepseek-r1:8b

# Embeddings
# Supported options: hash, local, openrouter, openai
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Other
ENVIRONMENT=development
LOG_LEVEL=DEBUG
