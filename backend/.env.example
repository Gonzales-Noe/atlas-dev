# Backend Environment Variables
# Copy this file to .env and fill in the actual values

# Django Settings
# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres.your-supabase-project-ref
DB_PASSWORD=your-database-password
DB_HOST=aws-0-your-region.pooler.supabase.com
# Transaction pooling avoids holding one of the limited session-mode clients per worker.
DB_PORT=5432
DB_SSLMODE=require

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-app-password

# Google Sheets API Configuration - Browser API Key
GOOGLE_API_KEY=your-google-api-key

# Google Sign-In (OAuth Web client ID used to verify mobile ID tokens)
GOOGLE_OAUTH_CLIENT_IDS=your-google-oauth-client-id.apps.googleusercontent.com

# Anthropic API Configuration
# Get your API key from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Ollama Cloud API Configuration (api.ollama.ai — OpenAI-compatible)
# OLLAMA_CLOUD_API_KEY=replace-me
# OLLAMA_CLOUD_BASE_URL=https://api.ollama.ai/v1
# OLLAMA_CLOUD_MODEL=llama3.2

# OpenRouter API Key (Provides Access to Gemini, GPT, etc.)
OPENROUTER_API_KEY=sk-or-replace-me

# Groq API Key
GROQ_API_KEY=gsk_replace_me

# Settings for Default LLM
# Supported options: 'gemini' (OpenRouter default), 'openrouter', 'groq', 'gpt', 'anthropic'
# DEFAULT_LLM_PROVIDER=gemini

# LLM Routing
# Supported options: ollama, gemini, openrouter, groq, gpt, anthropic
# Other options: groq, anthropic (claude-haiku), gpt (gpt-4o)
DEFAULT_LLM_PROVIDER=gemini

# Local Ollama (recommended free default)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Choose one local model available in your Ollama instance.
# DeepSeek-R1 and DeepSeek-V3 are common options.
OLLAMA_DEFAULT_MODEL=deepseek-r1:8b

# Stable fallback when external embedding APIs are unavailable
EMBEDDING_PROVIDER=local
# Upgraded: BGE-small-en-v1.5 (384-dim, smaller model, fast download)
LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# EMBEDDING_PROVIDER=openrouter_sdk
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_PROVIDER=openai
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# ==============================================================================
# Environment & General Django Settings
# ==============================================================================
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=DEBUG

# PayMongo test credentials from your PayMongo dashboard
PAYMONGO_SECRET_KEY=sk_test_replace_me
PAYMONGO_WEBHOOK_SECRET=pk_test_replace_me
