# Full ATLAS backend for Hostinger VPS (local embeddings + torch).
# Do NOT use the slim Render Dockerfile here — that omits PyTorch.
FROM python:3.11-slim-bookworm

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql-client \
    libpq-dev \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

RUN DJANGO_SETTINGS_MODULE=atlas.settings.prod \
    DB_NAME=postgres \
    DB_USER=postgres \
    DB_PASSWORD=build-placeholder \
    DB_HOST=localhost \
    DB_PORT=5432 \
    SECRET_KEY=build-placeholder \
    ALLOWED_HOSTS=localhost \
    python manage.py collectstatic --noinput || true

ENV PORT=8000
ENV WEB_CONCURRENCY=2
ENV EMBEDDING_PROVIDER=local
ENV OLLAMA_BASE_URL=http://127.0.0.1:11434
ENV OLLAMA_DEFAULT_MODEL=llama3.2:3b

RUN sed -i 's/\r$//' start.sh && chmod +x start.sh

CMD ["/bin/sh", "./start.sh"]
