# Backend Environment Variables
# Copy this file to .env and fill in actual values.

# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-change-me
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=atlas_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# API Keys
GOOGLE_API_KEY=your_google_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
GROQ_API_KEY=your_groq_api_key

# LLM Routing
# Supported options: gemini, openrouter, groq, gpt, anthropic
DEFAULT_LLM_PROVIDER=gemini

# Embeddings
# Supported options:
# - hash: deterministic local fallback (fastest setup, lowest semantic quality)
# - local: sentence-transformers model on your machine (recommended local default)
# - openrouter: remote API embeddings via OpenRouter
# - openai: remote API embeddings via OpenAI
EMBEDDING_PROVIDER=local

# Used only when EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Used only when EMBEDDING_PROVIDER=openrouter
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Used only when EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Other
ENVIRONMENT=development
LOG_LEVEL=DEBUG
