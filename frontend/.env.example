# Frontend (Vite) — copy to frontend/.env for local dev.
# On Render, set these as frontend service env vars, then rebuild.
# NEVER commit real secrets — use placeholders here only.

VITE_API_URL=https://your-api-host.example.com/api
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Local dev only: leave VITE_API_URL unset so requests go through the Vite
# proxy, and point the proxy at your Django runserver port.
# VITE_PROXY_TARGET=http://127.0.0.1:8000
