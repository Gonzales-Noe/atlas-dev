# Backend Environment Variables
# Copy this file to .env and fill in the actual values

# Django Core
SECRET_KEY=your-secret-key-here
DEBUG=True                      # set to False in production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

DB_ENGINE=django.db.backends.postgresql
DB_NAME=atlas_dev
DB_USER=postgres.your-supabase-project-ref
DB_PASSWORD=your-database-password
DB_HOST=aws-0-your-region.pooler.supabase.com
DB_PORT=5432

# Email Configuration
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-email-password

# Google Sheets API Configuration - Browser API Key
GOOGLE_API_KEY=your-google-api-key-here

#Google OAuth client id for frontend Google Identity Services
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret


# Anthropic API Configuration
# Get your API key from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Ollama Cloud API Configuration (api.ollama.ai — OpenAI-compatible)
# OLLAMA_CLOUD_API_KEY=your-ollama-cloud-key-here
# OLLAMA_CLOUD_BASE_URL=https://api.ollama.ai/v1
# OLLAMA_CLOUD_MODEL=llama3.2

# OpenRouter API Key (Provides Access to Gemini, GPT, etc.)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Groq API Key
GROQ_API_KEY=your-groq-api-key-here

# Settings for Default LLM
# Supported options: 'gemini' (OpenRouter default), 'openrouter', 'groq', 'gpt', 'anthropic'
DEFAULT_LLM_PROVIDER=gemini

# LLM Routing
# Supported options: ollama, gemini, openrouter, groq, gpt, anthropic

# Local Ollama (recommended free default)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Choose one local model available in your Ollama instance.
OLLAMA_DEFAULT_MODEL=deepseek-r1:8b

# Stable fallback when external embedding APIs are unavailable
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# EMBEDDING_PROVIDER=openrouter_sdk
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_PROVIDER=openai
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Other Settings
ENVIRONMENT=development
LOG_LEVEL=DEBUG