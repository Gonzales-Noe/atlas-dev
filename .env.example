# .env.example — Copy this file to .env and fill in your actual values
# !! NEVER commit the actual .env file to Git !!

# ── Django Core ─────────────────────────────────────────────
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True                      # set to False in production
DJANGO_SETTINGS_MODULE=atlas.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1, *.local,swagger-dense-barcode.ngrok-free.dev

# ── Database (PostgreSQL 16) ─────────────────────────────────
DB_NAME=atlas_db
DB_USER=atlas_user
DB_PASSWORD=your-db-password-here
DB_HOST=localhost
DB_PORT=5432

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# ── Anthropic Claude API ─────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Google Cloud / Sheets API ────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/path/to/service-account.json
GOOGLE_SHEETS_SCOPES=https://www.googleapis.com/auth/spreadsheets.readonly

# ── CORS ─────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
