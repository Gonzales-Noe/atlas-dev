# # Settings for Default LLM
# # Supported options: 'gemini' (OpenRouter default), 'openrouter', 'groq', 'gpt', 'anthropic'
# # DEFAULT_LLM_PROVIDER=gemini

# # LLM Routing
# # Supported options: ollama, gemini, openrouter, groq, gpt, anthropic
# # Other options: groq, anthropic (claude-haiku), gpt (gpt-4o)
# DEFAULT_LLM_PROVIDER=gemini

# # Local Ollama (recommended free default)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# # Choose one local model available in your Ollama instance.
# # DeepSeek-R1 and DeepSeek-V3 are common options.
# OLLAMA_DEFAULT_MODEL=deepseek-r1:8b

# # Stable fallback when external embedding APIs are unavailable
# EMBEDDING_PROVIDER=local
# # Upgraded: BGE-small-en-v1.5 (384-dim, smaller model, fast download)
# LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# # EMBEDDING_PROVIDER=openrouter_sdk
# # OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# # EMBEDDING_PROVIDER=openai
# # OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# # Other Settings
# ENVIRONMENT=development
# LOG_LEVEL=DEBUG